{{- $host := includeTemplate "host" . | fromJson -}}
-- Generated by chezmoi from .chezmoidata/hosts.yaml for host "{{ .chezmoi.hostname }}".
-- Do not edit here: change hosts.yaml and run `chezmoi apply`.
return {
    hostname = {{ .chezmoi.hostname | toJson }},
    split_workspaces = {{ $host.split_workspaces | default false }},
    primary = {{ $host.primary | default "" | toJson }},
    monitors = {
{{- range $host.monitors }}
        { output = {{ .output | toJson }}, mode = {{ .mode | toJson }}, position = {{ .position | toJson }}, scale = {{ .scale | toJson }} },
{{- end }}
    },
}
