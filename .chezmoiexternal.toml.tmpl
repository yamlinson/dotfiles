{{- $host := includeTemplate "host" . | fromJson -}}
{{- if and (eq .chezmoi.os "linux") $host.split_workspaces }}
# Lua plugin for Hyprland >= 0.55; loaded from hyprland.lua when split_workspaces is true.
[".config/hypr/plugins/split-monitor-workspaces"]
    type = "git-repo"
    url = "https://github.com/Duckonaut/split-monitor-workspaces.git"
    refreshPeriod = "168h"
{{- end }}
